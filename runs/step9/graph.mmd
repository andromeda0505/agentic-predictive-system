---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	planner(planner)
	statistician(statistician)
	critic(critic)
	__end__([<p>__end__</p>]):::last
	__start__ --> planner;
	critic -. &nbsp;__revision_limit__&nbsp; .-> __end__;
	critic -. &nbsp;revise_both&nbsp; .-> planner;
	critic -. &nbsp;revise_statistician&nbsp; .-> statistician;
	planner --> statistician;
	statistician --> critic;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
